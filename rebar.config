{erl_opts, [debug_info, warnings_as_errors]}.
{minimum_otp_vsn, "29"}.

%% The exports of a library are for its users: xref does not check that
%% the library itself uses them.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
